---
import ProjectCard from '@/components/ProjectCard.astro';
import { Button } from '@/components/ui/button';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<section
	class="relative py-24 bg-linear-to-bl from-background to-background via-secondary/20"
	id="projects"
>
	<div class="absolute inset-0 overflow-hidden pointer-events-none">
		<div
			class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-secondary/20 rounded-full blur-[120px]"
		>
		</div>
		<div
			class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px]"
		>
		</div>
	</div>

	<div class="relative px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
		<div class="mb-20 text-center">
			<h2
				class="mb-6 text-5xl font-bold tracking-tight uppercase md:text-7xl text-text"
			>
				Proyectos Destacados
			</h2>
			<p class="max-w-3xl mx-auto text-xl leading-relaxed text-text/70">
				Soluciones digitales que combinan diseño moderno con tecnología de
				vanguardia
			</p>
		</div>

		<div class="grid gap-8 mb-20 md:grid-cols-2 lg:grid-cols-3">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>

		<div class="text-center">
			<div
				class="inline-block p-10 border-2 rounded-none shadow-2xl glassmorphism backdrop-blur-md border-secondary/30"
			>
				<h3
					class="mb-4 text-3xl font-bold tracking-wide uppercase text-text"
				>
					¿Tienes un proyecto en mente?
				</h3>
				<p
					class="max-w-md mx-auto mb-8 text-lg leading-relaxed text-text/70"
				>
					Trabajemos juntos para crear algo extraordinario
				</p>
				<Button
					size="lg"
					className="bg-primary text-background hover:bg-primary/90 rounded-none font-bold px-10 py-6 text-lg uppercase tracking-wide glow-primary hover:shadow-2xl transition-all duration-300"
					onClick={() =>
						document
							.getElementById('contact')
							?.scrollIntoView({ behavior: 'smooth' })}
				>
					Iniciar Conversación
				</Button>
			</div>
		</div>
	</div>
</section>
