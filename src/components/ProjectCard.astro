---
import { ProjectInfo, ProjectDemo } from '@/components/buttons.tsx';
import { Image } from 'astro:assets';

const { project } = Astro.props;
const { title, description, mainImg, keyTech, demo } = project.data;
---

<div class="relative h-full group">
	<div
		class="relative flex flex-col h-full overflow-hidden transition-all duration-500 border-2 rounded-none shadow-xl glassmorphism-dark border-secondary/20 hover:border-secondary/60 hover:bg-background/95 hover:shadow-2xl"
	>
		<div class="relative overflow-hidden">
			<Image
				alt={title}
				src={mainImg || '/placeholder.svg'}
				class="object-cover w-full h-56 transition-transform duration-700 group-hover:scale-110"
				width={600}
				height={450}
			/>
			<div
				class="absolute inset-0 transition-opacity duration-300 opacity-0 bg-linear-to-t from-background via-background/60 to-transparent group-hover:opacity-100"
			>
			</div>

			<div
				class="absolute inset-0 flex items-center justify-center gap-4 transition-opacity duration-300 opacity-0 group-hover:opacity-100"
			>
				{demo && <ProjectDemo url={demo} />}
				<ProjectInfo url={`/projects/${project.id}`} />
			</div>
		</div>

		<div class="flex flex-col flex-1 space-y-5 p-7">
			<div class="flex-1">
				<h3
					class="mb-3 text-2xl font-bold leading-tight tracking-tight uppercase transition-colors duration-300 text-text group-hover:text-primary"
				>
					{title}
				</h3>
				<p class="text-base leading-relaxed text-text/70">{description}</p>
			</div>

			<div class="flex flex-wrap gap-2 pt-4 border-t border-secondary/20">
				{
					keyTech.map((tech: any) => (
						<span class="px-3 py-1.5 text-xs font-bold bg-secondary/15 text-secondary rounded-none border border-secondary/30 uppercase tracking-wide">
							{tech}
						</span>
					))
				}
			</div>
		</div>

		 <div class="absolute inset-0 transition-opacity duration-500 rounded-none opacity-0 bg-linear-to-r from-primary/10 to-secondary/10 group-hover:opacity-100 -z-10 blur-2xl"></div>
	</div>
</div>
