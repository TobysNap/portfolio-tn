---
import type { CollectionEntry } from 'astro:content';
import { AlertCircle, Code2, Target, TrendingUp } from 'lucide-react';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { goal, impact, challenges, stack } = project.data;
---

<section
	class="relative py-20 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-background to-background via-secondary/10"
>
	<div class="max-w-7xl mx-auto">
		<h2
			class="text-3xl md:text-4xl font-bold text-text uppercase mb-16 text-center"
		>
			Detalles del Valor y Proceso
		</h2>

		<div class="grid lg:grid-cols-12 gap-6">
			<div
				class="glassmorphism backdrop-blur-sm lg:col-span-8 order-2 lg:order-1 border-2 border-secondary/30 rounded-none p-6 hover:border-secondary/50 transition-all hover:shadow-2xl hover:shadow-secondary/20"
			>
				<div class="flex items-center gap-3 mb-5">
					<div class="p-2 bg-primary/20 rounded-none border border-primary/30">
						<Target className="size-5 text-primary" />
					</div>
					<h3 class="text-xl font-bold text-primary uppercase tracking-wide">
						Objetivo e Impacto
					</h3>
				</div>
				<div class="space-y-5">
					<h4
						class="text-text font-semibold mb-2 uppercase text-xs tracking-wider"
					>
						Objetivo:
					</h4>
					<p class="text-text/80 leading-relaxed text-base">{goal}</p>
				</div>

				<div class="pt-4 border-t border-primary/20">
					<h4
						class="text-primary font-semibold mb-3 uppercase text-xs tracking-wider"
					>
						Impacto Logrado:
					</h4>
					<div class="grid grid-cols-2 gap-3">
						{
							impact.map((item) => (
								<div class="bg-primary/10 border border-primary/20 rounded-none p-3 hover:bg-primary/15 transition-colors">
									<h5 class="text-3xl font-bold text-primary mb-1">
										{item.title}
									</h5>
									<p class="text-text/70 text-xs uppercase tracking-wide">
										{item.subtitle}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<div
				class="md:col-span-4 md:order-2 glassmorphism backdrop-blur-sm border-2 border-secondary/30 rounded-none p-6 hover:border-secondary/50 transition-all hover:shadow-2xl hover:shadow-secondary/20"
			>
				<div class="flex items-center gap-3 mb-5">
					<div
						class="p-2 bg-secondary/20 rounded-none border border-secondary/30"
					>
						<AlertCircle className="size-6 text-secondary" />
					</div>
					<h3 class="text-xl font-bold text-secondary uppercase tracking-wide">
						Desafíos
					</h3>
				</div>
				<ul class="space-y-3 list-disc list-inside">
					{
						challenges.map((challenge) => (
							<li class="text-text/80 leading-relaxed text-sm">
								                  {challenge}           
							</li>
						))
					}
				</ul>
			</div>

			<div
				class="md:col-span-12 order-3 glassmorphism backdrop-blur-sm border-2 border-secondary/30 rounded-none p-6 hover:border-secondary/50 transition-all hover:shadow-2xl hover:shadow-secondary/20"
			>
				<div class="flex items-center gap-3 mb-5">
					<div
						class="p-2 bg-secondary/20 rounded-none border border-secondary/30"
					>
						<Code2 className="w-6 h-6 text-secondary" />
					</div>
					<h3 class="text-xl font-bold text-text uppercase tracking-wide">
						Stack Tecnológico
					</h3>
				</div>
				<div class="flex flex-wrap gap-2">
					{
						stack.map((tech) => (
							<span class="bg-secondary/10 text-secondary border border-secondary/30 rounded-none px-4 py-2 text-xs font-medium uppercase tracking-wide hover:bg-secondary/20 hover:border-secondary/50 transition-colors">
								{tech}
							</span>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
