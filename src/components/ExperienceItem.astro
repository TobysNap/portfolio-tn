---
import { render } from 'astro:content';
import { MoreInfo } from '@/components/buttons';

const { experience } = Astro.props;
const { company, date, role, infoUrl } = experience.data;

const { Content } = await render(experience);
---

<article
	class="w-full py-8 transition-all duration-300 border-2 rounded-none cursor-pointer group hover:translate-x-3 border-secondary/20 text-text/80 hover:text-text hover:bg-secondary/10 hover:border-secondary/40 backdrop-blur-sm glassmorphism-dark"
>
	<div class="grid gap-12 p-10 md:grid-cols-2">
		<h3
			class="text-3xl font-bold leading-tight tracking-tight uppercase md:text-5xl text-text"
		>
			{company}
		</h3>

		<div>
			<div class="flex flex-col gap-3 mb-6">
				<h3
					class="text-2xl font-bold tracking-wide uppercase md:text-3xl text-primary text-glow-primary"
				>
					{role}
				</h3>
				<span
					class="text-base font-medium tracking-wider uppercase text-text/60"
					>{date}</span
				>
			</div>

			<p class="text-lg leading-relaxed md:text-xl text-text/80">
				<Content />
			</p>

			<div class="flex gap-4">
				{infoUrl && <MoreInfo url={infoUrl} />}
			</div>
		</div>
	</div>
</article>
<style is:global>
	.glow {
		text-shadow: #fc0 1px 0 10px;
	}

	@media (prefers-reduced-motion: no-preference) {
		@keyframes show {
			from {
				opacity: 0;
				scale: 50%;
			}
			to {
				opacity: 1;
				scale: 100%;
			}
		}
	}

	.show {
		view-timeline-name: --reveal;

		animation-name: show;
		animation-fill-mode: both;

		animation-timeline: --reveal;
		animation-range: entry 0% cover 45%;
	}
</style>
